{
  "name": "smart-video-engine",
  "version": "0.1.0",
  "description": "Free, browser-based script-to-video generator: AI images (Pollinations, free & keyless), local text-to-speech (Kokoro via WebGPU/WASM), canvas compositing with pan/zoom effects, and ffmpeg.wasm muxing into a downloadable MP4. No server, no API keys required for the core pipeline.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "ai",
    "video-generation",
    "text-to-video",
    "text-to-speech",
    "kokoro",
    "ffmpeg-wasm",
    "webgpu",
    "script-to-video"
  ],
  "license": "MPL-2.0",
  "dependencies": {
    "@ffmpeg/ffmpeg": "^0.12.10",
    "@ffmpeg/util": "^0.12.1",
    "kokoro-js": "^1.2.0"
  },
  "devDependencies": {
    "tsup": "^8.2.4",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=18"
  }
}
